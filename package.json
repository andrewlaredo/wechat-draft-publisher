{
  "name": "wechat-draft-publisher",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wechat-publish": "./bin/wechat-publish.js"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('dist', {recursive: true, force: true}); try { fs.unlinkSync('server.js'); } catch {}\"",
    "lint": "tsc --noEmit",
    "icons:sync": "node scripts/sync-icons.js",
    "wails:dev": "wails dev",
    "wails:build": "node scripts/sync-icons.js && wails build",
    "wails:build:windows": "node scripts/sync-icons.js && wails build -platform windows/amd64",
    "wails:build:darwin": "node scripts/sync-icons.js && wails build -platform darwin/universal",
    "wails:build:linux": "node scripts/sync-icons.js && wails build -platform linux/amd64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "commander": "^15.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "form-data": "^4.0.6",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "juice": "^12.1.3",
    "lucide-react": "^0.546.0",
    "markdown-it": "^15.0.2",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.4",
    "turndown": "^7.2.4",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
